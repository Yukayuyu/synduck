# Explicit offline demonstration. This does not call a model.
LLM_PROVIDER=demo
# Set LLM_PROVIDER=openai for real responses. Configure the key server-side.
LLM_API_KEY=
LLM_MODEL=
DATABASE_PATH=./data/context-canvas.sqlite
ASSET_PATH=./data/assets
API_PORT=3001
APP_PORT=3000

# Optional ChatGPT/Codex provider. Or connect and select it in "模型與登入".
# The app uses its own official Codex installation and auth directory.
# Optional initial model; choose and save an available model in the UI.
CODEX_MODEL=
APP_CODEX_HOME=./data/codex
MODEL_SETTINGS_PATH=./data/model-settings.json

# Cross-device access: set both fields below and use an HTTPS reverse proxy.
# Keep API_HOST on loopback when the proxy runs on the same computer.
API_HOST=127.0.0.1
PUBLIC_ORIGIN=
# Choose a unique password of at least 16 characters; never commit it.
APP_PASSWORD=

# Local executor is initially disabled. Configure the project in the UI.
# Task history and tool outcomes stay on this backend, outside version folders.
LOCAL_RUNTIME_PATH=./data/local-runtime
# Optional first-start project; subsequent UI settings take precedence.
LOCAL_PROJECT_ROOT=
# Updates use a public release repository; no GitHub token is required.
# Optional MCP secrets: reference MCP_ variable names in integration settings.
# Values stay server-side; ChatGPT authorization does not authorize MCP services.
MCP_SERVICE_TOKEN=
