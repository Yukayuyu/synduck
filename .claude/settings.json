{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"$HOME/.claude/skills/gstack\" ] || (command -v bun &>/dev/null && bash \"$(git rev-parse --show-toplevel)/tools/install-gstack.sh\" 2>/dev/null || true)",
            "timeout": 120,
            "statusMessage": "Checking gstack install..."
          }
        ]
      }
    ]
  }
}
